{
    "name": "netgsm/sms",
    "description": "Netgsm SMS API v3 client",
    "type": "library",
    "license": "MIT",
    "keywords": ["netgsm", "sms", "bulk sms", "laravel", "symfony"],
    "homepage": "https://api-docs.netgsm.com.tr/",
    "authors": [
        {
            "name": "Netgsm",
            "email": "teknikdestek@netgsm.com.tr"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Netgsm\\Sms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netgsm\\Sms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
